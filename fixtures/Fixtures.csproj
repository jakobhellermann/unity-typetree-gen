<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test fixtures for unity-typetree-gen. Self-contained: the
       UnityEngine stubs live in this assembly too, so building needs
       no real Unity references and the produced DLL resolves on its
       own. One class per type-tree test case. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Fixtures</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
